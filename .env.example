# Serene Mental Wellness App Configuration
SERENE_PORT=8000
SERENE_HOST=127.0.0.1

# Recommended HTTPS Email API (works reliably on cloud hosts like Railway)
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=Serene Wellness <onboarding@resend.dev>

# Optional SMTP Fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Serene Wellness <noreply@serene.local>
SMTP_USE_TLS=true

# Dev outbox is automatically disabled in cloud production (RAILWAY_ENVIRONMENT / SERENE_ENV=production)
SERENE_DEV_OUTBOX=auto
PUBLIC_BASE_URL=http://127.0.0.1:8000
